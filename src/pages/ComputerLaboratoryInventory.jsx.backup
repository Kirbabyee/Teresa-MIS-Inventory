import { useEffect, useMemo, useState } from "react";
import { Download, Plus, PencilLine, Trash2 } from "lucide-react";
import ExcelJS from "exceljs";
import { saveAs } from "file-saver";
import { supabase } from "@/api/supabaseClient";
import { Input } from "@/components/ui/input";
import {
  Dialog,
  DialogContent,
  DialogDescription,
  DialogFooter,
  DialogHeader,
  DialogTitle,
} from "@/components/ui/dialog";

const INITIAL_LAB_OPTIONS = [
  { value: 1, label: "Laboratory 1" },
  { value: 2, label: "Laboratory 2" },
  { value: 3, label: "Laboratory 3" },
  { value: 4, label: "Laboratory 4" },
  { value: 5, label: "Laboratory 5" },
];

const TABLE_HEADING = [
  "COMPUTER #",
  "MOTHERBOARD",
  "PROCESSOR",
  "MEMORY",
  "SSD",
  "HDD",
  "VIDEO CARD",
  "AVR",
  "MOUSE",
  "POWER SUPPLY",
  "KEYBOARD",
  "MONITOR",
  "OPERATING SYSTEM",
];

const VALID_TYPES = new Set(TABLE_HEADING.slice(1));
const COMPONENT_ROWS = [
  ["Brand", "brand"],
  ["Description", "description"],
  ["Remarks", "remarks"],
];

const TABLE_COLUMNS = ["COMPUTER #", "", ...TABLE_HEADING.slice(1)];

const formatValue = (value) => {
  if (value === null || value === undefined || value === "") return "-";
  return String(value);
};

const sanitizeSheetName = (value) => String(value || "Computer Lab").replace(/[\\/:*?"<>|]/g, "").slice(0, 31);

const slugify = (value = "") =>
  String(value)
    .toLowerCase()
    .trim()
    .replace(/[^a-z0-9]+/g, "-")
    .replace(/^-+|-+$/g, "");

const buildLabSlug = (label, sortOrder) => {
  const baseSlug = slugify(label) || "laboratory";
  return `${baseSlug}-${sortOrder}`;
};

const loadOrCreateComputerLabTab = async () => {
  const { data: tabData, error: tabError } = await supabase
    .from("inventory_tabs")
    .select("id")
    .eq("slug", "comlab")
    .maybeSingle();

  if (tabError) {
    throw tabError;
  }

  if (tabData?.id) {
    return tabData.id;
  }

  const { data: insertedTab, error: insertError } = await supabase
    .from("inventory_tabs")
    .insert({
      name: "Comlab",
      slug: "comlab",
      description: "Computer laboratory inventory tabs.",
      sort_order: 2,
    })
    .select("id")
    .single();

  if (insertError) {
    throw insertError;
  }

  return insertedTab.id;
};

const loadComputerLabSections = async () => {
  const tabId = await loadOrCreateComputerLabTab();

  const { data: sectionsData, error: sectionsError } = await supabase
    .from("inventory_sections")
    .select("name, sort_order")
    .eq("tab_id", tabId)
    .order("sort_order", { ascending: true });

  if (sectionsError) {
    throw sectionsError;
  }

  let labs = (sectionsData || []).map((section) => ({
    value: Number(section.sort_order),
    label: section.name || `Laboratory ${section.sort_order}`,
  }));

  if (labs.length === 0) {
    const initialSections = INITIAL_LAB_OPTIONS.map((lab) => ({
      tab_id: tabId,
      name: lab.label,
      slug: buildLabSlug(lab.label, lab.value),
      description: "",
      sort_order: lab.value,
    }));

    const { error: seedError } = await supabase.from("inventory_sections").insert(initialSections);

    if (seedError && !seedError.message.includes("duplicate")) {
      throw seedError;
    }

    labs = INITIAL_LAB_OPTIONS;
  }

  return { tabId, labs };
};

export default function ComputerLaboratoryInventory() {
  const [labOptions, setLabOptions] = useState([]);
  const [selectedLab, setSelectedLab] = useState(null);
  const [isEditMode, setIsEditMode] = useState(false);
  const [isAddLabOpen, setIsAddLabOpen] = useState(false);
  const [newLabName, setNewLabName] = useState("");
  const [savingLab, setSavingLab] = useState(false);
  const [rows, setRows] = useState([]);
  const [loading, setLoading] = useState(true);
  const [error, setError] = useState("");
  const [exporting, setExporting] = useState(false);

  const selectedLabLabel = useMemo(
    () => labOptions.find((lab) => lab.value === selectedLab)?.label || "Laboratory",
    [labOptions, selectedLab]
  );

  const initialLabsRef = useState(() => INITIAL_LAB_OPTIONS)[0];

  useEffect(() => {
    let cancelled = false;

    const loadLaboratories = async () => {
      try {
        const { tabId, labs } = await loadComputerLabSections();

        if (cancelled) return;

        setLabOptions(labs);
        setSelectedLab((current) => (current !== null && labs.some((lab) => lab.value === current) ? current : labs[0]?.value ?? 1));
      } catch (loadError) {
        if (cancelled) return;

        console.error("Failed to load laboratory tabs:", loadError.message);
        setLabOptions(initialLabsRef);
        setSelectedLab(initialLabsRef[0]?.value ?? 1);
      }
    };

    loadLaboratories();

    return () => {
      cancelled = true;
    };
  }, [initialLabsRef]);

  const openAddLabModal = () => {
    const nextValue = Math.max(...labOptions.map((lab) => lab.value), 0) + 1;
    setNewLabName(`Laboratory ${nextValue}`);
    setIsAddLabOpen(true);
  };

  const handleAddLab = async () => {
    const nextLabel = newLabName.trim();
    if (!nextLabel) return;

    const nextValue = Math.max(...labOptions.map((lab) => lab.value), 0) + 1;

    setSavingLab(true);
    try {
      const tabId = await loadOrCreateComputerLabTab();

      const { error: insertError } = await supabase.from("inventory_sections").insert({
        tab_id: tabId,
        name: nextLabel,
        slug: buildLabSlug(nextLabel, nextValue),
        description: "",
        sort_order: nextValue,
      });

      if (insertError) throw insertError;

      const { labs } = await loadComputerLabSections();

      setLabOptions(labs);
      setSelectedLab(nextValue);
      setIsAddLabOpen(false);
      setNewLabName("");
    } catch (labError) {
      console.error("Failed to add laboratory:", labError.message);
      setError(labError.message || "Failed to add laboratory.");
    } finally {
      setSavingLab(false);
    }
  };

  const handleDeleteLab = async (lab) => {
    if (labOptions.length <= 1) {
      setError("At least one laboratory must remain.");
      return;
    }

    const confirmed = window.confirm(
      `Delete ${lab.label}? This will remove the tab and all component records assigned to this laboratory.`
    );

    if (!confirmed) return;

    setSavingLab(true);
    try {
      const tabId = await loadOrCreateComputerLabTab();

      const { error: deleteComponentsError } = await supabase
        .from("computers_components")
        .delete()
        .eq("lab_number", lab.value);

      if (deleteComponentsError) throw deleteComponentsError;

      const { error: deleteSectionError } = await supabase
        .from("inventory_sections")
        .delete()
        .eq("tab_id", tabId)
        .eq("sort_order", lab.value);

      if (deleteSectionError) throw deleteSectionError;

      const { labs: nextLabs } = await loadComputerLabSections();
      const fallbackLab = nextLabs[0]?.value || INITIAL_LAB_OPTIONS[0].value;

      setLabOptions(nextLabs);
      setSelectedLab((current) => (nextLabs.some((item) => item.value === current) ? current : fallbackLab));
    } catch (deleteError) {
      console.error("Failed to delete laboratory:", deleteError.message);
      setError(deleteError.message || "Failed to delete laboratory.");
    } finally {
      setSavingLab(false);
    }
  };

  useEffect(() => {
    let cancelled = false;

    const fetchLabComponents = async () => {
      setLoading(true);
      setError("");

      const { data, error: fetchError } = await supabase
        .from("computers_components")
        .select("computer_number, type, brand, description, status")
        .eq("lab_number", selectedLab)
        .order("computer_number", { ascending: true });

      if (cancelled) return;

      if (fetchError) {
        console.error("Failed to load laboratory components:", fetchError.message);
        setError(fetchError.message || "Failed to load laboratory components.");
        setRows([]);
        setLoading(false);
        return;
      }

      const grouped = Object.values(
        (data || []).reduce((accumulator, item) => {
          const computerKey = item.computer_number ?? "Unknown";
          if (!accumulator[computerKey]) {
            accumulator[computerKey] = { "COMPUTER #": item.computer_number, components: {} };
          }

          const type = item.type?.toString().trim().toUpperCase();
          if (type && VALID_TYPES.has(type)) {
            accumulator[computerKey].components[type] = {
              brand: item.brand || "-",
              description: item.description || "-",
              remarks: item.status || "-",
            };
          }

          return accumulator;
        }, {}),
      ).sort((left, right) => Number(left["COMPUTER #"]) - Number(right["COMPUTER #"]));

      setRows(grouped);
      setLoading(false);
    };

    fetchLabComponents();

    return () => {
      cancelled = true;
    };
  }, [selectedLab]);

  const exportLab = async () => {
    if (rows.length === 0) return;

    setExporting(true);
    try {
      const workbook = new ExcelJS.Workbook();
      const worksheet = workbook.addWorksheet(sanitizeSheetName(selectedLabLabel));

      worksheet.mergeCells("A1:N1");
      worksheet.getCell("A1").value = "COLEGIO DE STA. TERESA DE AVILA, INC.";
      worksheet.getCell("A1").alignment = { horizontal: "center" };

      worksheet.mergeCells("A2:N2");
      worksheet.getCell("A2").value = `${selectedLabLabel} Computer Laboratory Inventory`;
      worksheet.getCell("A2").alignment = { horizontal: "center" };

      worksheet.mergeCells("A3:N3");
      worksheet.getCell("A3").value = `AS OF ${new Date().toLocaleDateString()}`;
      worksheet.getCell("A3").alignment = { horizontal: "center" };

      worksheet.addRow([]);

      const headers = ["COMPUTER #", "", ...TABLE_HEADING.slice(1)];
      const headerRow = worksheet.addRow(headers);
      headerRow.eachCell((cell) => {
        cell.font = { bold: true };
        cell.alignment = { horizontal: "center", vertical: "middle" };
      });

      rows.forEach((row) => {
        COMPONENT_ROWS.forEach(([label, field], rowIndex) => {
          const excelRow = [rowIndex === 0 ? row["COMPUTER #"] : "", label];

          TABLE_HEADING.slice(1).forEach((componentType) => {
            const component = row.components?.[componentType] || {};
            excelRow.push(formatValue(component[field]));
          });

          worksheet.addRow(excelRow);
        });
      });

      const buffer = await workbook.xlsx.writeBuffer();
      const blob = new Blob([buffer], {
        type: "application/vnd.openxmlformats-officedocument.spreadsheetml.sheet",
      });
      saveAs(blob, `${selectedLabLabel.replace(/\s+/g, "_")}_Inventory.xlsx`);
    } finally {
      setExporting(false);
    }
  };

  return (
    <div className="p-6 space-y-5">
      <Dialog open={isAddLabOpen} onOpenChange={setIsAddLabOpen}>
        <DialogContent className="sm:max-w-md">
          <DialogHeader>
            <DialogTitle>Add Laboratory</DialogTitle>
            <DialogDescription>Create a new laboratory tab for the computer laboratory section.</DialogDescription>
          </DialogHeader>
          <div className="space-y-2">
            <label className="text-sm font-medium text-slate-700" htmlFor="laboratory-name">
              Laboratory name
            </label>
            <Input
              id="laboratory-name"
              value={newLabName}
              onChange={(event) => setNewLabName(event.target.value)}
              placeholder="Laboratory 6"
            />
          </div>
          <DialogFooter>
            <button
              type="button"
              onClick={() => setIsAddLabOpen(false)}
              className="rounded-lg border border-slate-200 px-4 py-2 text-sm font-medium text-slate-700 transition hover:bg-slate-100"
            >
              Cancel
            </button>
            <button
              type="button"
              onClick={handleAddLab}
              disabled={!newLabName.trim() || savingLab}
              className="rounded-lg bg-[#4a1111] px-4 py-2 text-sm font-medium text-white transition hover:bg-[#5a1717] disabled:cursor-not-allowed disabled:bg-slate-300"
            >
              {savingLab ? "Adding..." : "Add Laboratory"}
            </button>
          </DialogFooter>
        </DialogContent>
      </Dialog>

      <div className="flex flex-col items-center justify-between gap-3 sm:flex-row sm:gap-4">
        <div className="flex flex-wrap items-center justify-center gap-1.5 sm:justify-start">
          {labOptions.map((lab) => (
            <div key={lab.value} className="flex items-center gap-1">
              <button
                type="button"
                onClick={() => setSelectedLab(lab.value)}
                className={`rounded-lg px-3 py-1.5 text-xs font-medium transition ${
                  lab.value === selectedLab
                    ? "bg-[#4a1111] text-white"
                    : "bg-white text-slate-600 hover:bg-slate-100 hover:text-slate-900"
                }`}
              >
                {lab.label}
              </button>
              {isEditMode && (
                <button
                  type="button"
                  onClick={() => handleDeleteLab(lab)}
                  disabled={savingLab}
                  className="inline-flex h-8 w-8 items-center justify-center rounded-lg border border-slate-200 bg-white text-slate-500 transition hover:bg-rose-50 hover:text-rose-700 disabled:cursor-not-allowed disabled:opacity-50"
                  title={`Delete ${lab.label}`}
                  aria-label={`Delete ${lab.label}`}
                >
                  <Trash2 className="h-4 w-4" />
                </button>
              )}
            </div>
          ))}
          {isEditMode && (
            <button
              type="button"
              onClick={openAddLabModal}
              className="inline-flex items-center justify-center rounded-lg border border-dashed border-slate-300 bg-white px-3 py-1.5 text-xs font-medium text-slate-600 transition hover:bg-slate-100 hover:text-slate-900"
              title="Add laboratory"
              aria-label="Add laboratory"
            >
              <Plus className="h-4 w-4" />
            </button>
          )}
        </div>
        <div className="flex items-center gap-2">
          <button
            type="button"
            onClick={exportLab}
            disabled={loading || rows.length === 0 || exporting}
            className="inline-flex h-9 w-9 items-center justify-center rounded-lg bg-[#4a1111] text-white transition hover:bg-[#5a1717] disabled:cursor-not-allowed disabled:bg-slate-300"
            title={exporting ? "Exporting..." : "Export"}
            aria-label={exporting ? "Exporting" : "Export"}
          >
            <Download className="h-4 w-4" />
          </button>
          <button
            type="button"
            onClick={() => setIsEditMode((current) => !current)}
            className={`inline-flex h-9 w-9 items-center justify-center rounded-lg transition ${
              isEditMode
                ? "bg-slate-900 text-white hover:bg-slate-800"
                : "bg-white text-slate-700 border border-slate-200 hover:bg-slate-100"
            }`}
            title={isEditMode ? "Exit edit mode" : "Edit mode"}
            aria-label={isEditMode ? "Exit edit mode" : "Edit mode"}
          >
            <PencilLine className="h-4 w-4" />
          </button>
        </div>
      </div>

      <div className="bg-white rounded-xl shadow-sm border border-slate-200 overflow-hidden">
        <div className="min-w-0 overflow-hidden p-0">
            {loading ? (
              <div className="flex flex-col items-center justify-center gap-3 py-16">
                <div className="h-10 w-10 animate-spin rounded-full border-4 border-slate-300 border-t-[#4a1111]" />
                <p className="text-sm text-slate-500">Loading...</p>
              </div>
            ) : error ? (
              <div className="border-t border-rose-200 bg-rose-50 p-4 text-center text-sm text-rose-700">
                {error}
              </div>
            ) : rows.length === 0 ? (
              <div className="py-16 text-center">
                <p className="text-sm text-slate-500">No component records found for this laboratory.</p>
              </div>
            ) : (
              <div className="computer-lab-scrollbar h-[80vh] min-h-0 w-full max-w-full overflow-auto">
                <table className="w-max min-w-full divide-y divide-slate-200">
                  <thead className="sticky top-0 z-20 bg-slate-100">
                    <tr>
                      {TABLE_COLUMNS.map((heading, index) => (
                        <th
                          key={`${heading || "row-label"}-${index}`}
                          scope="col"
                          className="whitespace-nowrap border-r border-slate-300 px-4 py-4 text-center text-xs font-semibold uppercase tracking-wider text-slate-700 last:border-r-0"
                        >
                          {heading}
                        </th>
                      ))}
                    </tr>
                  </thead>
                  <tbody className="divide-y divide-slate-200 bg-white">
                    {rows.flatMap((row, computerIndex) =>
                      COMPONENT_ROWS.map(([label, field], rowIndex) => {
                        const shadedRow = computerIndex % 2 === 0 ? "bg-slate-50" : "bg-slate-200/70";
                        const groupDivider = rowIndex === 0 ? "border-t-2 border-slate-300" : "border-t border-slate-200";

                        return (
                          <tr
                            key={`${row["COMPUTER #"]}-${field}`}
                            className={`transition hover:bg-slate-100 ${shadedRow} ${groupDivider}`}
                          >
                            {rowIndex === 0 && (
                              <td
                                rowSpan={COMPONENT_ROWS.length}
                                className={`whitespace-nowrap border-r border-slate-200 px-4 py-4 text-center align-middle font-semibold text-slate-900 ${shadedRow}`}
                              >
                                {formatValue(row["COMPUTER #"])}
                              </td>
                            )}
                            <td className="whitespace-nowrap border-r border-slate-200 px-4 py-4 text-sm font-semibold text-slate-700">
                              {label}
                            </td>
                            {TABLE_HEADING.slice(1).map((componentType) => {
                              const componentData = row.components?.[componentType] || {};
                              const value = componentData[field] || "-";

                              return (
                                <td
                                  key={`${row["COMPUTER #"]}-${componentType}-${field}`}
                                  className="border-r border-slate-200 px-4 py-4 text-sm last:border-r-0"
                                >
                                  <div className="text-slate-900 font-medium">{value}</div>
                                </td>
                              );
                            })}
                          </tr>
                        );
                      })
                    )}
                  </tbody>
                </table>
              </div>
            )}
        </div>
      </div>
    </div>
  );
}

